import { Slider, SpinBox, ComboBox, Switch, LineEdit, Button, ScrollView, Palette } from "std-widgets.slint";

export struct StageValue {
    x: int,
    y: int,
}

global Theme {
    out property <length> label-width: 170px;
    out property <length> combo-width: 190px;
    out property <length> spin-width: 110px;
    out property <color> muted: Palette.foreground.with-alpha(0.55);
    out property <color> ok: #44d62c;
    out property <color> warn: #ff9a1f;
    out property <color> bad: #ff4d4d;
}

// Label column plus controls packed to the left.
component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 10px;
    alignment: start;
    VerticalLayout {
        width: Theme.label-width;
        alignment: center;
        Text { text: label; }
        if hint != "": Text {
            text: hint;
            font-size: 11px;
            color: Theme.muted;
        }
    }
    @children
}

// Same, but controls stretch to fill (sliders).
component WideRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    Text {
        width: Theme.label-width;
        text: label;
        vertical-alignment: center;
    }
    @children
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    height: 20px;
    width: chip-text.preferred-width + 16px;
    border-radius: 10px;
    background: tint.with-alpha(0.18);
    chip-text := Text {
        text: root.text;
        color: root.tint;
        font-size: 11px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in property <string> status;
    in property <color> status-tint;
    background: Palette.alternate-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.status != "": Chip {
                text: root.status;
                tint: root.status-tint;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.summary;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
        @children
    }
}

component BatteryBar inherits HorizontalLayout {
    in property <string> side;
    in property <int> percent: -1; // -1 = not connected
    spacing: 6px;
    alignment: start;
    Text {
        text: side;
        vertical-alignment: center;
        color: Theme.muted;
    }
    Rectangle {
        width: 90px;
        Rectangle {
            height: 10px;
            border-radius: 5px;
            background: Palette.foreground.with-alpha(0.12);
            Rectangle {
                x: 0;
                width: parent.width * max(0, root.percent) / 100;
                border-radius: 5px;
                background: root.percent <= 20 ? Theme.bad : root.percent <= 40 ? Theme.warn : Theme.ok;
            }
        }
    }
    Text {
        width: 40px;
        text: root.percent < 0 ? "–" : root.percent + "%";
        vertical-alignment: center;
    }
}

component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: swatch;
    border-width: selected ? 3px : 1px;
    border-color: selected ? Palette.foreground : Palette.border;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A DPI spin box that follows `source` when it changes from outside.
component DpiSpin inherits SpinBox {
    in property <int> source;
    in property <int> max-dpi: 16000;
    width: Theme.spin-width;
    minimum: 100;
    maximum: max-dpi;
    step-size: 50;
    value: source;
    changed source => { self.value = self.source; }
}

component Placeholder inherits Text {
    color: Theme.muted;
    wrap: word-wrap;
}

// Everything the window shows and reports; Rust talks to this global.
export global AppState {
    // ---- Viper ----
    in-out property <bool> viper-present;
    in-out property <string> viper-name: "Razer Viper";
    in-out property <int> max-dpi: 16000;
    in-out property <int> dpi: 800;
    in-out property <int> dpi-y: 800;
    in-out property <bool> xy-separate;
    in-out property <[StageValue]> stages;
    in-out property <int> active-stage: 1;      // 1-based
    in-out property <int> stage-count-index;    // stages.length - 1
    // Set while the user edits stages; Rust stops overwriting them until applied.
    in-out property <bool> stages-dirty;
    in-out property <int> polling-index;        // 0 = 125, 1 = 500, 2 = 1000 Hz
    in-out property <int> brightness: 128;      // 0..255
    in-out property <int> logo-effect-index;    // off, static, breathing, spectrum
    in-out property <string> logo-color: "44d62c";

    callback dpi-changed(int, int);
    callback stage-count-changed(int);
    callback stages-apply();
    callback stages-revert();
    callback polling-changed(int);
    callback brightness-changed(int);
    callback logo-changed(int, string);

    // ---- Earbuds ----
    in-out property <bool> dongle-present;
    in-out property <bool> buds-connected;
    in-out property <int> battery-left: -1;
    in-out property <int> battery-right: -1;
    in-out property <int> anc-index;            // off, anc, ambient; -1 unknown
    in-out property <int> eq-index: -1;         // game, music, movie, flat; -1 not set
    in-out property <int> timeout-index: -1;    // off, 5, 15, 30, 45, 60 min
    in-out property <bool> mic-on: true;
    in-out property <bool> reduce-calls;
    in-out property <bool> dnd;
    in-out property <bool> auto-pause;
    in-out property <bool> gestures;
    in-out property <bool> prompts;
    // Settings the devices can't report, still unknown until set here once.
    in-out property <bool> auto-pause-known;
    in-out property <bool> gestures-known;
    in-out property <bool> prompts-known;

    callback anc-changed(int);
    callback eq-changed(int);
    callback timeout-changed(int);
    callback mic-changed(bool);
    callback toggle-changed(string, bool);

    // ---- App ----
    in-out property <string> config-path;
    in-out property <string> last-event;
    in-out property <bool> autostart;
    callback autostart-changed(bool);
    callback open-config();

    out property <[string]> polling-names: ["125 Hz", "500 Hz", "1000 Hz"];
}

component ViperCard inherits VerticalLayout {
    Card {
        title: AppState.viper-name;
        status: AppState.viper-present ? "Connected" : "Not connected";
        status-tint: AppState.viper-present ? Theme.ok : Theme.muted;
        summary: !AppState.viper-present ? ""
            : (AppState.xy-separate && AppState.dpi != AppState.dpi-y
                ? AppState.dpi + "×" + AppState.dpi-y : AppState.dpi)
            + " DPI · " + (AppState.polling-index >= 0 ? AppState.polling-names[AppState.polling-index] : "");

        if !AppState.viper-present: Placeholder {
            text: "Plug in the mouse; saved settings are applied automatically.";
        }

        if AppState.viper-present: VerticalLayout {
            spacing: 10px;

            WideRow {
                label: AppState.xy-separate ? "DPI X" : "DPI";
                Slider {
                    property <int> source: AppState.dpi;
                    changed source => { self.value = self.source; }
                    minimum: 100;
                    maximum: AppState.max-dpi;
                    value: AppState.dpi;
                    step: 50;
                    released(v) => {
                        AppState.dpi = round(v / 50) * 50;
                        AppState.dpi-changed(AppState.dpi, AppState.xy-separate ? AppState.dpi-y : AppState.dpi);
                    }
                }
                DpiSpin {
                    source: AppState.dpi;
                    max-dpi: AppState.max-dpi;
                    edited(v) => {
                        AppState.dpi = v;
                        AppState.dpi-changed(v, AppState.xy-separate ? AppState.dpi-y : v);
                    }
                }
            }
            if AppState.xy-separate: WideRow {
                label: "DPI Y";
                Slider {
                    property <int> source: AppState.dpi-y;
                    changed source => { self.value = self.source; }
                    minimum: 100;
                    maximum: AppState.max-dpi;
                    value: AppState.dpi-y;
                    step: 50;
                    released(v) => {
                        AppState.dpi-y = round(v / 50) * 50;
                        AppState.dpi-changed(AppState.dpi, AppState.dpi-y);
                    }
                }
                DpiSpin {
                    source: AppState.dpi-y;
                    max-dpi: AppState.max-dpi;
                    edited(v) => {
                        AppState.dpi-y = v;
                        AppState.dpi-changed(AppState.dpi, v);
                    }
                }
            }
            Row {
                label: "Separate X / Y";
                Switch { checked <=> AppState.xy-separate; }
            }

            Rectangle { height: 1px; background: Palette.border; }

            Row {
                label: "DPI stages";
                hint: "Cycled by the button under the mouse";
                ComboBox {
                    width: 80px;
                    model: ["1", "2", "3", "4", "5"];
                    current-index <=> AppState.stage-count-index;
                    selected => { AppState.stage-count-changed(self.current-index + 1); }
                }
            }
            for st[i] in AppState.stages: Row {
                label: "Stage " + (i + 1);
                DpiSpin {
                    source: st.x;
                    max-dpi: AppState.max-dpi;
                    edited(v) => {
                        AppState.stages[i] = { x: v, y: AppState.xy-separate ? st.y : v };
                        AppState.stages-dirty = true;
                    }
                }
                if AppState.xy-separate: DpiSpin {
                    source: st.y;
                    max-dpi: AppState.max-dpi;
                    edited(v) => {
                        AppState.stages[i] = { x: st.x, y: v };
                        AppState.stages-dirty = true;
                    }
                }
                if i + 1 == AppState.active-stage: VerticalLayout {
                    alignment: center;
                    Chip {
                        text: "Active";
                        tint: Theme.ok;
                    }
                }
                if i + 1 != AppState.active-stage: Button {
                    text: "Make active";
                    clicked => {
                        AppState.active-stage = i + 1;
                        AppState.stages-dirty = true;
                    }
                }
            }
            if AppState.stages-dirty: HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Text {
                    text: "Unsaved stage changes";
                    color: Theme.muted;
                    vertical-alignment: center;
                }
                Button {
                    text: "Revert";
                    clicked => { AppState.stages-revert(); }
                }
                Button {
                    text: "Apply stages";
                    primary: true;
                    clicked => { AppState.stages-apply(); }
                }
            }

            Rectangle { height: 1px; background: Palette.border; }

            Row {
                label: "Polling rate";
                ComboBox {
                    width: Theme.combo-width;
                    model: AppState.polling-names;
                    current-index <=> AppState.polling-index;
                    selected => { AppState.polling-changed(self.current-index); }
                }
            }
            Row {
                label: "Logo effect";
                ComboBox {
                    width: Theme.combo-width;
                    model: ["Off", "Static", "Breathing", "Spectrum"];
                    current-index <=> AppState.logo-effect-index;
                    selected => { AppState.logo-changed(self.current-index, AppState.logo-color); }
                }
            }
            Row {
                label: "Logo colour";
                for c in [
                    { hex: "44d62c", col: #44d62c },
                    { hex: "ff0000", col: #ff0000 },
                    { hex: "ff7a00", col: #ff7a00 },
                    { hex: "ffd400", col: #ffd400 },
                    { hex: "00c8ff", col: #00c8ff },
                    { hex: "0040ff", col: #0040ff },
                    { hex: "a020f0", col: #a020f0 },
                    { hex: "ffffff", col: #ffffff },
                ]: VerticalLayout {
                    alignment: center;
                    Swatch {
                        swatch: c.col;
                        selected: AppState.logo-color == c.hex;
                        clicked => {
                            AppState.logo-color = c.hex;
                            if (AppState.logo-effect-index == 0 || AppState.logo-effect-index == 3) {
                                AppState.logo-effect-index = 1;
                            }
                            AppState.logo-changed(AppState.logo-effect-index, c.hex);
                        }
                    }
                }
                LineEdit {
                    property <string> source: AppState.logo-color;
                    changed source => { self.text = self.source; }
                    width: 96px;
                    text: AppState.logo-color;
                    placeholder-text: "RRGGBB";
                    accepted(t) => {
                        AppState.logo-color = t;
                        AppState.logo-changed(AppState.logo-effect-index, t);
                    }
                }
            }
            WideRow {
                label: "Logo brightness";
                Slider {
                    property <int> source: AppState.brightness;
                    changed source => { self.value = self.source; }
                    minimum: 0;
                    maximum: 255;
                    value: AppState.brightness;
                    released(v) => {
                        AppState.brightness = round(v);
                        AppState.brightness-changed(AppState.brightness);
                    }
                }
                Text {
                    width: 44px;
                    text: round(AppState.brightness * 100 / 255) + "%";
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
    }

}

component BudsCard inherits VerticalLayout {
    Card {
        title: "Hammerhead V3 HyperSpeed";
        status: !AppState.dongle-present ? "Dongle not connected"
            : AppState.buds-connected ? "Connected" : "In case or asleep";
        status-tint: AppState.buds-connected ? Theme.ok : Theme.muted;

        if !AppState.dongle-present: Placeholder {
            text: "Plug in the HyperSpeed dongle.";
        }
        if AppState.dongle-present && !AppState.buds-connected: Placeholder {
            text: "Take the earbuds out of the case (or tap one to wake it). Settings are applied once they connect.";
        }

        if AppState.dongle-present && AppState.buds-connected: VerticalLayout {
            spacing: 10px;
            Row {
                label: "Battery";
                BatteryBar { side: "L"; percent: AppState.battery-left; }
                BatteryBar { side: "R"; percent: AppState.battery-right; }
            }
            Row {
                label: "Noise control";
                ComboBox {
                    width: Theme.combo-width;
                    model: ["Off", "ANC", "Ambient"];
                    current-index <=> AppState.anc-index;
                    selected => { AppState.anc-changed(self.current-index); }
                }
            }
            Row {
                label: "EQ preset";
                ComboBox {
                    width: Theme.combo-width;
                    model: ["Game", "Music", "Movie", "Flat"];
                    current-index <=> AppState.eq-index;
                    selected => { AppState.eq-changed(self.current-index); }
                }
            }
            Row {
                label: "Power saving";
                hint: "Turn off when idle";
                ComboBox {
                    width: Theme.combo-width;
                    model: ["Off", "After 5 min", "After 15 min", "After 30 min", "After 45 min", "After 60 min"];
                    current-index <=> AppState.timeout-index;
                    selected => { AppState.timeout-changed(self.current-index); }
                }
            }

            Rectangle { height: 1px; background: Palette.border; }

            Row {
                label: "Microphone";
                Switch {
                    checked <=> AppState.mic-on;
                    toggled => { AppState.mic-changed(self.checked); }
                }
            }
            Row {
                label: "Reduce ANC on calls";
                hint: "Bluetooth calls only";
                Switch {
                    checked <=> AppState.reduce-calls;
                    toggled => { AppState.toggle-changed("reduce-calls", self.checked); }
                }
            }
            Row {
                label: "Do not disturb";
                hint: "While gaming on 2.4 GHz";
                Switch {
                    checked <=> AppState.dnd;
                    toggled => { AppState.toggle-changed("dnd", self.checked); }
                }
            }
            Row {
                label: "Auto-pause";
                hint: AppState.auto-pause-known ? "" : "Not reported by the earbuds";
                Switch {
                    checked <=> AppState.auto-pause;
                    toggled => { AppState.toggle-changed("auto-pause", self.checked); }
                }
            }
            Row {
                label: "Touch gestures";
                hint: AppState.gestures-known ? "" : "Not reported by the earbuds";
                Switch {
                    checked <=> AppState.gestures;
                    toggled => { AppState.toggle-changed("gestures", self.checked); }
                }
            }
            Row {
                label: "Voice prompts";
                hint: AppState.prompts-known ? "" : "Not reported by the earbuds";
                Switch {
                    checked <=> AppState.prompts;
                    toggled => { AppState.toggle-changed("prompts", self.checked); }
                }
            }
        }
    }

}

component AppCard inherits VerticalLayout {
    Card {
        title: "App";
        Row {
            label: "Start with Windows";
            Switch {
                checked <=> AppState.autostart;
                toggled => { AppState.autostart-changed(self.checked); }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Text {
                width: Theme.label-width;
                text: "Config file";
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: AppState.config-path;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
            Button {
                text: "Open";
                clicked => { AppState.open-config(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Windows settings pages. Values shown are what Windows currently uses; every
// change is saved to the profile and applied at once.

export global WinState {
    in property <bool> available;

    // Mouse
    in property <int> pointer-speed: 10;
    in property <bool> enhance-precision;
    in property <int> scroll-lines: 3;          // 0 = one screen
    in property <int> scroll-chars: 3;
    in property <bool> scroll-inactive-windows;
    in property <int> double-click-ms: 500;
    in property <bool> swap-buttons;
    in property <int> double-click-area: 4;
    in property <int> drag-threshold: 4;
    in property <int> hover-ms: 400;
    in property <bool> focus-follows-mouse;
    in property <bool> focus-raise;
    in property <int> focus-delay-ms;
    in property <bool> hide-while-typing;
    in property <bool> locate-with-ctrl;
    in property <int> trails;
    in property <bool> click-lock;
    in property <int> click-lock-ms: 1200;
    in property <bool> snap-to-default-button;
    in property <bool> mouse-keys;
    in property <bool> curve-default: true;

    // Keyboard
    in property <int> repeat-delay: 1;          // 0..3
    in property <int> repeat-rate: 31;          // 0..31
    in property <int> caret-blink-ms: 530;      // 0 = no blinking
    in property <bool> custom-repeat;
    in property <int> custom-repeat-delay-ms: 300;
    in property <int> custom-repeat-interval-ms: 30;
    in property <bool> sticky-keys-shortcut;
    in property <bool> filter-keys-shortcut;
    in property <bool> toggle-keys-shortcut;
    in property <bool> lock-key-beep;
    in property <int> language-hotkey-index: -1; // alt-shift, ctrl-shift, grave, none

    /// `key` is `<section>.<field>` as in config.toml; `value` is TOML.
    callback set(string /* key */, string /* value */);
    callback reset-curve();
    callback restore();

    out property <[float]> speed-multipliers: [
        0.03125, 0.0625, 0.125, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875, 1.0,
        1.25, 1.5, 1.75, 2.0, 2.25, 2.5, 2.75, 3.0, 3.25, 3.5];
    out property <[string]> language-hotkey-keys: ["alt-shift", "ctrl-shift", "grave", "none"];
}

component WinSwitch inherits Row {
    in property <string> key;
    in property <bool> value;
    Switch {
        property <bool> source: root.value;
        changed source => { self.checked = self.source; }
        checked: root.value;
        toggled => { WinState.set(root.key, self.checked ? "true" : "false"); }
    }
}

component WinSpin inherits Row {
    in property <string> key;
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 10000;
    in property <int> step: 1;
    in property <string> unit;
    SpinBox {
        property <int> source: root.value;
        changed source => { self.value = self.source; }
        width: Theme.spin-width;
        minimum: root.minimum;
        maximum: root.maximum;
        step-size: root.step;
        value: root.value;
        edited(v) => { WinState.set(root.key, v); }
    }
    if root.unit != "": Text {
        text: root.unit;
        color: Theme.muted;
        vertical-alignment: center;
    }
}

component MouseCoreCard inherits Card {
    title: "Pointer & scrolling";
    summary: "Speed " + WinState.pointer-speed + " · ×" + WinState.speed-multipliers[WinState.pointer-speed - 1];

    WideRow {
        label: "Pointer speed";
        Slider {
            property <int> source: WinState.pointer-speed;
            changed source => { self.value = self.source; }
            minimum: 1;
            maximum: 20;
            step: 1;
            value: WinState.pointer-speed;
            released(v) => { WinState.set("mouse.pointer_speed", round(v)); }
        }
        Text {
            width: 64px;
            text: "×" + WinState.speed-multipliers[WinState.pointer-speed - 1];
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
    Placeholder {
        text: "10 is 1:1: one count from the mouse moves the pointer one pixel. For gaming, keep 10 and change DPI instead.";
        font-size: 11px;
    }
    WinSwitch {
        label: "Enhance pointer precision";
        hint: "Windows acceleration; off for consistent aim";
        key: "mouse.enhance_precision";
        value: WinState.enhance-precision;
    }
    Row {
        label: "Acceleration curve";
        hint: "Registry SmoothMouseX/YCurve";
        if WinState.curve-default: VerticalLayout {
            alignment: center;
            Chip { text: "Windows default"; tint: Theme.ok; }
        }
        if !WinState.curve-default: VerticalLayout {
            alignment: center;
            Chip { text: "Modified"; tint: Theme.warn; }
        }
        if !WinState.curve-default: Button {
            text: "Reset";
            clicked => { WinState.reset-curve(); }
        }
    }

    Rectangle { height: 1px; background: Palette.border; }

    WinSpin {
        label: "Scroll lines per notch";
        hint: "0 = one screen at a time";
        key: "mouse.scroll_lines";
        value: WinState.scroll-lines;
        maximum: 100;
    }
    WinSpin {
        label: "Horizontal scroll";
        hint: "Characters per tilt";
        key: "mouse.scroll_chars";
        value: WinState.scroll-chars;
        maximum: 100;
    }
    WinSwitch {
        label: "Scroll inactive windows";
        hint: "Scroll whatever is under the pointer";
        key: "mouse.scroll_inactive_windows";
        value: WinState.scroll-inactive-windows;
    }

    Rectangle { height: 1px; background: Palette.border; }

    WinSpin {
        label: "Double-click speed";
        hint: "Max time between clicks";
        key: "mouse.double_click_ms";
        value: WinState.double-click-ms;
        minimum: 200;
        maximum: 900;
        step: 10;
        unit: "ms";
    }
    WinSwitch {
        label: "Swap primary button";
        hint: "Left-handed: right button clicks";
        key: "mouse.swap_buttons";
        value: WinState.swap-buttons;
    }
}

component MouseAdvancedCard inherits Card {
    title: "Advanced";
    summary: "Not in Windows Settings";

    WinSpin {
        label: "Double-click area";
        hint: "How far the 2nd click may land";
        key: "mouse.double_click_area";
        value: WinState.double-click-area;
        minimum: 1;
        maximum: 64;
        unit: "px";
    }
    WinSpin {
        label: "Drag threshold";
        hint: "Movement before a drag starts";
        key: "mouse.drag_threshold";
        value: WinState.drag-threshold;
        minimum: 1;
        maximum: 64;
        unit: "px";
    }
    WinSpin {
        label: "Hover time";
        hint: "Before tooltips and hover menus";
        key: "mouse.hover_ms";
        value: WinState.hover-ms;
        minimum: 0;
        maximum: 5000;
        step: 50;
        unit: "ms";
    }

    Rectangle { height: 1px; background: Palette.border; }

    WinSwitch {
        label: "Focus follows mouse";
        hint: "Activate the window under the pointer";
        key: "mouse.focus_follows_mouse";
        value: WinState.focus-follows-mouse;
    }
    if WinState.focus-follows-mouse: WinSwitch {
        label: "Raise focused window";
        hint: "Also bring it to the front";
        key: "mouse.focus_raise";
        value: WinState.focus-raise;
    }
    if WinState.focus-follows-mouse: WinSpin {
        label: "Focus delay";
        key: "mouse.focus_delay_ms";
        value: WinState.focus-delay-ms;
        maximum: 5000;
        step: 50;
        unit: "ms";
    }
}

component PointerHelpersCard inherits Card {
    title: "Pointer helpers";

    WinSwitch {
        label: "Hide while typing";
        key: "mouse.hide_while_typing";
        value: WinState.hide-while-typing;
    }
    WinSwitch {
        label: "Show location with Ctrl";
        hint: "Press Ctrl to find the pointer";
        key: "mouse.locate_with_ctrl";
        value: WinState.locate-with-ctrl;
    }
    WinSpin {
        label: "Pointer trails";
        hint: "0 = off";
        key: "mouse.trails";
        value: WinState.trails;
        maximum: 7;
    }
    WinSwitch {
        label: "Snap to default button";
        hint: "Jump to OK in new dialogs";
        key: "mouse.snap_to_default_button";
        value: WinState.snap-to-default-button;
    }
    WinSwitch {
        label: "ClickLock";
        hint: "Hold briefly to lock the button";
        key: "mouse.click_lock";
        value: WinState.click-lock;
    }
    if WinState.click-lock: WinSpin {
        label: "ClickLock delay";
        key: "mouse.click_lock_ms";
        value: WinState.click-lock-ms;
        minimum: 200;
        maximum: 2200;
        step: 100;
        unit: "ms";
    }
    WinSwitch {
        label: "Mouse Keys";
        hint: "Move the pointer with the numpad";
        key: "mouse.mouse_keys";
        value: WinState.mouse-keys;
    }
}

component KeyboardCard inherits Card {
    title: "Typing";
    summary: WinState.custom-repeat ? "Custom repeat active" : "";

    Row {
        label: "Repeat delay";
        ComboBox {
            width: Theme.combo-width;
            model: ["Short (~250 ms)", "Medium (~500 ms)", "Long (~750 ms)", "Longest (~1 s)"];
            property <int> source: WinState.repeat-delay;
            changed source => { self.current-index = self.source; }
            current-index: WinState.repeat-delay;
            selected => { WinState.set("keyboard.repeat_delay", self.current-index); }
        }
    }
    WideRow {
        label: "Repeat rate";
        Slider {
            property <int> source: WinState.repeat-rate;
            changed source => { self.value = self.source; }
            minimum: 0;
            maximum: 31;
            step: 1;
            value: WinState.repeat-rate;
            released(v) => { WinState.set("keyboard.repeat_rate", round(v)); }
        }
        Text {
            width: 64px;
            // Windows maps 0..31 to roughly 2.5..30 repeats per second.
            text: round(2.5 + WinState.repeat-rate * 27.5 / 31) + "/s";
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
    WinSpin {
        label: "Cursor blink rate";
        hint: "0 = no blinking";
        key: "keyboard.caret_blink_ms";
        value: WinState.caret-blink-ms;
        maximum: 2000;
        step: 10;
        unit: "ms";
    }
    Row {
        label: "Try it";
        LineEdit {
            width: 280px;
            placeholder-text: "Hold a key here to test repeat";
        }
    }
    Row {
        label: "Switch input language";
        ComboBox {
            width: Theme.combo-width;
            model: ["Alt + Shift", "Ctrl + Shift", "Grave accent (`)", "Not assigned"];
            property <int> source: WinState.language-hotkey-index;
            changed source => { self.current-index = self.source; }
            current-index: WinState.language-hotkey-index;
            selected => { WinState.set("keyboard.language_hotkey", "\"" + WinState.language-hotkey-keys[self.current-index] + "\""); }
        }
    }
}

component KeyboardAdvancedCard inherits Card {
    title: "Advanced";
    summary: "Not in Windows Settings";

    WinSwitch {
        label: "Custom repeat timing";
        hint: "Exact delay/interval via FilterKeys";
        key: "keyboard.custom_repeat";
        value: WinState.custom-repeat;
    }
    if WinState.custom-repeat: WinSpin {
        label: "Delay before repeat";
        key: "keyboard.custom_repeat_delay_ms";
        value: WinState.custom-repeat-delay-ms;
        minimum: 100;
        maximum: 2000;
        step: 10;
        unit: "ms";
    }
    if WinState.custom-repeat: WinSpin {
        label: "Repeat interval";
        hint: "Lower is faster";
        key: "keyboard.custom_repeat_interval_ms";
        value: WinState.custom-repeat-interval-ms;
        minimum: 5;
        maximum: 500;
        step: 1;
        unit: "ms";
    }

    Rectangle { height: 1px; background: Palette.border; }

    Text {
        text: "Accessibility shortcuts";
        font-weight: 600;
    }
    WinSwitch {
        label: "Sticky Keys shortcut";
        hint: "Shift pressed 5 times";
        key: "keyboard.sticky_keys_shortcut";
        value: WinState.sticky-keys-shortcut;
    }
    WinSwitch {
        label: "Filter Keys shortcut";
        hint: "Right Shift held 8 s";
        key: "keyboard.filter_keys_shortcut";
        value: WinState.filter-keys-shortcut;
    }
    WinSwitch {
        label: "Toggle Keys shortcut";
        hint: "Num Lock held 5 s";
        key: "keyboard.toggle_keys_shortcut";
        value: WinState.toggle-keys-shortcut;
    }
    WinSwitch {
        label: "Lock key sounds";
        hint: "Beep on Caps / Num / Scroll Lock";
        key: "keyboard.lock_key_beep";
        value: WinState.lock-key-beep;
    }
}

component RestoreCard inherits Card {
    title: "Windows settings profile";
    Placeholder {
        text: "Changes here are saved in your HIDConfig profile and re-applied at start-up. Before the first change, HIDConfig saved your previous Windows values.";
    }
    HorizontalLayout {
        alignment: end;
        Button {
            text: "Restore previous Windows settings";
            clicked => { WinState.restore(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Audio page

export struct AudioDev {
    id: string,
    name: string,
    output: bool,
    is-default: bool,
    is-comms: bool,
    volume: float,          // 0..100
    muted: bool,
    spatial-supported: bool,
    spatial-names: [string], // "Off" first
    spatial-index: int,
    spatial-note: string,   // e.g. "selected but not active"
    formats: [string],
    format-index: int,
    has-enhancements: bool,
    enhancements: bool,
    exclusive: bool,
    exclusive-priority: bool,
}

export struct AudioApp {
    pid: int,
    name: string,
    volume: float,          // 0..100
    muted: bool,
}

export global AudioState {
    in property <[AudioDev]> outputs;
    in property <[AudioDev]> inputs;
    in property <[AudioApp]> apps;
    // "Same as default" first, then device names.
    in property <[string]> comms-output-names;
    in property <[string]> comms-input-names;
    in property <int> comms-output-index;
    in property <int> comms-input-index;
    in property <int> ducking-index: 1;
    in property <bool> mono;
    in-out property <string> expanded;

    callback make-default(string /* id */);
    callback volume(string /* id */, float);
    callback mute(string /* id */, bool);
    callback spatial(string /* id */, int);
    callback format(string /* id */, int);
    callback enhancements(string /* id */, bool);
    callback exclusive(string /* id */, bool /* allowed */, bool /* priority */);
    callback app-volume(int /* pid */, float);
    callback app-mute(int /* pid */, bool);
    callback comms(bool /* output */, int /* index */);
    callback ducking(int);
    callback mono-changed(bool);
}

component MuteButton inherits Rectangle {
    in property <bool> muted;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: muted ? Theme.bad.with-alpha(0.25) : touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
    Text {
        // Speaker / muted glyphs from Segoe Fluent Icons; fall back to text if absent.
        text: root.muted ? "\u{E74F}" : "\u{E767}";
        font-family: "Segoe Fluent Icons";
        font-size: 15px;
        color: root.muted ? Theme.bad : Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component VolumeRow inherits HorizontalLayout {
    in property <float> volume;
    in property <bool> muted;
    callback set-volume(float);
    callback set-mute(bool);
    spacing: 8px;
    MuteButton {
        muted: root.muted;
        clicked => { root.set-mute(!root.muted); }
    }
    Slider {
        property <float> source: root.volume;
        changed source => { self.value = self.source; }
        minimum: 0;
        maximum: 100;
        value: root.volume;
        changed(v) => { root.set-volume(v); }
    }
    Text {
        width: 40px;
        text: round(root.volume) + "%";
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component DeviceRow inherits VerticalLayout {
    in property <AudioDev> dev;
    private property <bool> open: AudioState.expanded == dev.id;
    spacing: 6px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.dev.name;
            overflow: elide;
            vertical-alignment: center;
            font-weight: root.dev.is-default ? 600 : 400;
        }
        if root.dev.is-default: VerticalLayout {
            alignment: center;
            Chip { text: "Default"; tint: Theme.ok; }
        }
        if root.dev.is-comms: VerticalLayout {
            alignment: center;
            Chip { text: "Calls"; tint: #4aa3ff; }
        }
        if !root.dev.is-default: Button {
            text: "Make default";
            clicked => { AudioState.make-default(root.dev.id); }
        }
        Button {
            text: root.open ? "Hide options" : "Options";
            clicked => { AudioState.expanded = root.open ? "" : root.dev.id; }
        }
    }
    VolumeRow {
        volume: root.dev.volume;
        muted: root.dev.muted;
        set-volume(v) => { AudioState.volume(root.dev.id, v); }
        set-mute(m) => { AudioState.mute(root.dev.id, m); }
    }

    if root.open: Rectangle {
        background: Palette.background;
        border-radius: 6px;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            if root.dev.output && root.dev.spatial-supported: Row {
                label: "Spatial sound";
                hint: root.dev.spatial-note;
                ComboBox {
                    width: 230px;
                    model: root.dev.spatial-names;
                    property <int> source: root.dev.spatial-index;
                    changed source => { self.current-index = self.source; }
                    current-index: root.dev.spatial-index;
                    selected => { AudioState.spatial(root.dev.id, self.current-index); }
                }
            }
            if root.dev.formats.length > 0: Row {
                label: "Format";
                hint: "Shared-mode sample rate / depth";
                ComboBox {
                    width: 230px;
                    model: root.dev.formats;
                    property <int> source: root.dev.format-index;
                    changed source => { self.current-index = self.source; }
                    current-index: root.dev.format-index;
                    selected => { AudioState.format(root.dev.id, self.current-index); }
                }
            }
            if root.dev.has-enhancements: Row {
                label: "Audio enhancements";
                hint: "Driver effects (EQ, virtual surround ...)";
                Switch {
                    property <bool> source: root.dev.enhancements;
                    changed source => { self.checked = self.source; }
                    checked: root.dev.enhancements;
                    toggled => { AudioState.enhancements(root.dev.id, self.checked); }
                }
            }
            Row {
                label: "Exclusive mode";
                hint: "Apps may take sole control";
                Switch {
                    property <bool> source: root.dev.exclusive;
                    changed source => { self.checked = self.source; }
                    checked: root.dev.exclusive;
                    toggled => { AudioState.exclusive(root.dev.id, self.checked, root.dev.exclusive-priority); }
                }
            }
            if root.dev.exclusive: Row {
                label: "Exclusive apps first";
                hint: "Give them priority";
                Switch {
                    property <bool> source: root.dev.exclusive-priority;
                    changed source => { self.checked = self.source; }
                    checked: root.dev.exclusive-priority;
                    toggled => { AudioState.exclusive(root.dev.id, root.dev.exclusive, self.checked); }
                }
            }
        }
    }
}

component OutputsCard inherits Card {
    title: "Output";
    for d in AudioState.outputs: DeviceRow { dev: d; }
    if AudioState.outputs.length == 0: Placeholder { text: "No active output devices."; }
}

component InputsCard inherits Card {
    title: "Input";
    for d in AudioState.inputs: DeviceRow { dev: d; }
    if AudioState.inputs.length == 0: Placeholder { text: "No active input devices."; }
}

component AppsCard inherits Card {
    title: "Apps";
    summary: AudioState.apps.length + " playing";
    for a in AudioState.apps: VerticalLayout {
        spacing: 2px;
        Text {
            text: a.name;
            overflow: elide;
        }
        VolumeRow {
            volume: a.volume;
            muted: a.muted;
            set-volume(v) => { AudioState.app-volume(a.pid, v); }
            set-mute(m) => { AudioState.app-mute(a.pid, m); }
        }
    }
    if AudioState.apps.length == 0: Placeholder { text: "No app is using audio right now."; }
}

component CallsCard inherits Card {
    title: "Calls & accessibility";
    Row {
        label: "Call output";
        ComboBox {
            width: 260px;
            model: AudioState.comms-output-names;
            property <int> source: AudioState.comms-output-index;
            changed source => { self.current-index = self.source; }
            current-index: AudioState.comms-output-index;
            selected => { AudioState.comms(true, self.current-index); }
        }
    }
    Row {
        label: "Call microphone";
        ComboBox {
            width: 260px;
            model: AudioState.comms-input-names;
            property <int> source: AudioState.comms-input-index;
            changed source => { self.current-index = self.source; }
            current-index: AudioState.comms-input-index;
            selected => { AudioState.comms(false, self.current-index); }
        }
    }
    Row {
        label: "During calls";
        hint: "What happens to other sounds";
        ComboBox {
            width: 260px;
            model: ["Mute other sounds", "Reduce others by 80 %", "Reduce others by 50 %", "Do nothing"];
            property <int> source: AudioState.ducking-index;
            changed source => { self.current-index = self.source; }
            current-index: AudioState.ducking-index;
            selected => { AudioState.ducking(self.current-index); }
        }
    }
    Row {
        label: "Mono audio";
        hint: "Same sound in both ears";
        Switch {
            property <bool> source: AudioState.mono;
            changed source => { self.checked = self.source; }
            checked: AudioState.mono;
            toggled => { AudioState.mono-changed(self.checked); }
        }
    }
}

component NavTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    width: label.preferred-width + 28px;
    height: 40px;
    label := Text {
        text: root.text;
        font-weight: root.active ? 600 : 400;
        color: root.active ? Palette.foreground : Theme.muted;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: root.active ? Theme.ok : transparent;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsWindow inherits Window {
    title: "HIDConfig";
    icon: @image-url("../../../packaging/hidconfig.png");
    preferred-width: 600px;
    preferred-height: 820px;
    min-width: 460px;
    min-height: 300px;
    background: Palette.background;

    // 0 = devices, 1 = mouse, 2 = keyboard, 3 = audio
    in-out property <int> page;
    // Two columns once there is room for two readable cards side by side.
    private property <bool> wide: self.width >= 1080px;

    VerticalLayout {
        // Navigation
        Rectangle {
            background: Palette.alternate-background;
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                NavTab { text: "Devices"; active: root.page == 0; clicked => { root.page = 0; } }
                NavTab { text: "Mouse"; active: root.page == 1; clicked => { root.page = 1; } }
                NavTab { text: "Keyboard"; active: root.page == 2; clicked => { root.page = 2; } }
                NavTab { text: "Audio"; active: root.page == 3; clicked => { root.page = 3; } }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Palette.border;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                // ---- Devices ----
                if root.page == 0 && root.wide: HorizontalLayout {
                    alignment: center;
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        max-width: 640px;
                        horizontal-stretch: 1;
                        alignment: start;
                        ViperCard { }
                    }
                    VerticalLayout {
                        max-width: 640px;
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 16px;
                        BudsCard { }
                        AppCard { }
                    }
                }
                if root.page == 0 && !root.wide: HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        max-width: 640px;
                        min-width: 420px;
                        horizontal-stretch: 1;
                        padding: 20px;
                        spacing: 16px;
                        ViperCard { }
                        BudsCard { }
                        AppCard { }
                    }
                }

                // ---- Mouse ----
                if root.page == 1 && !WinState.available: Placeholder {
                    text: "Reading Windows settings…";
                }
                if root.page == 1 && WinState.available && root.wide: HorizontalLayout {
                    alignment: center;
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        max-width: 640px;
                        horizontal-stretch: 1;
                        alignment: start;
                        MouseCoreCard { }
                    }
                    VerticalLayout {
                        max-width: 640px;
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 16px;
                        MouseAdvancedCard { }
                        PointerHelpersCard { }
                        RestoreCard { }
                    }
                }
                if root.page == 1 && WinState.available && !root.wide: HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        max-width: 640px;
                        min-width: 420px;
                        horizontal-stretch: 1;
                        padding: 20px;
                        spacing: 16px;
                        MouseCoreCard { }
                        MouseAdvancedCard { }
                        PointerHelpersCard { }
                        RestoreCard { }
                    }
                }

                // ---- Audio ----
                if root.page == 3 && root.wide: HorizontalLayout {
                    alignment: center;
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        max-width: 640px;
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 16px;
                        OutputsCard { }
                        InputsCard { }
                    }
                    VerticalLayout {
                        max-width: 640px;
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 16px;
                        AppsCard { }
                        CallsCard { }
                    }
                }
                if root.page == 3 && !root.wide: HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        max-width: 640px;
                        min-width: 420px;
                        horizontal-stretch: 1;
                        padding: 20px;
                        spacing: 16px;
                        OutputsCard { }
                        InputsCard { }
                        AppsCard { }
                        CallsCard { }
                    }
                }

                // ---- Keyboard ----
                if root.page == 2 && WinState.available && root.wide: HorizontalLayout {
                    alignment: center;
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        max-width: 640px;
                        horizontal-stretch: 1;
                        alignment: start;
                        KeyboardCard { }
                    }
                    VerticalLayout {
                        max-width: 640px;
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 16px;
                        KeyboardAdvancedCard { }
                        RestoreCard { }
                    }
                }
                if root.page == 2 && WinState.available && !root.wide: HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        max-width: 640px;
                        min-width: 420px;
                        horizontal-stretch: 1;
                        padding: 20px;
                        spacing: 16px;
                        KeyboardCard { }
                        KeyboardAdvancedCard { }
                        RestoreCard { }
                    }
                }
            }
        }

        // Status bar
        Rectangle {
            height: 28px;
            background: Palette.alternate-background;
            Rectangle {
                y: 0;
                height: 1px;
                background: Palette.border;
            }
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                Text {
                    text: AppState.last-event == "" ? "Ready" : AppState.last-event;
                    color: Theme.muted;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
}
